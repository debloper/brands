---
// Rename this file to `<YourBrand>Guide.astro` (matching your brand's name/slug).
import Logo from './Logo.astro';
---

<div class="min-h-screen flex flex-col bg-background">
  <header class="border-b border-border">
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-10 md:py-14">
      <Logo variant="full" size={40} />
      <h1 class="text-3xl md:text-4xl font-medium text-foreground tracking-tight mt-4">Brand Kit</h1>
      <p class="text-muted-foreground mt-2 text-sm">Replace this page with your own guide sections.</p>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 md:px-10 py-12 flex-1 w-full space-y-20">
    <section>
      <h2 class="text-2xl font-medium text-foreground mb-3">Getting started</h2>
      <p class="text-muted-foreground max-w-2xl">
        Replace this section with your logo, color, typography, and usage guidance — see
        <code>src/components/breakerspace/</code> for a fully worked example, and the checklist in
        <code>context/_template/design.md</code> for the required shape.
      </p>
    </section>
  </main>

  <footer class="border-t border-border mt-auto">
    <div class="max-w-7xl mx-auto px-6 md:px-10 py-6">
      <p class="text-muted-foreground text-sm">&copy; Your Brand.</p>
    </div>
  </footer>
</div>
